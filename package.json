{
  "name": "vercube-starter-app",
  "version": "1.0.0",
  "description": "Vercube Starter App",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vercube build",
    "dev": "vercube dev",
