  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@vercube/cli": "latest",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2"
  }
}
