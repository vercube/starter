{
  "name": "vercube-fullstack-app",
  "version": "1.0.0",
  "description": "Vercube + Vue fullstack app",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run.mjs build",
    "test:tscheck": "node scripts/run.mjs test:tscheck",
    "test:lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint --fix . && oxfmt --no-error-on-unmatched-pattern"
  },
  "license": "ISC",
  "devDependencies": {
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0"
  }
}
